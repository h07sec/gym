rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default-deny all reads and writes
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Hardened Primitives & Single-Pass RBAC Helpers
    // -------------------------------------------------------------------------
    function isValidId(id) {
      let s = id;
      return s is string && s.size() >= 1 && s.size() <= 128 && s.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function hasVerifiedEmail() {
      return ('email' in request.auth.token) && request.auth.token.email is string;
    }

    function emailMatches(expected) {
      return hasVerifiedEmail() && expected is string &&
        request.auth.token.email.lower() == expected.lower();
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/platform_admins/$(request.auth.uid));
    }

    function isPublicRegistrationAllowed() {
      let settingsPath = /databases/$(database)/documents/platform_settings/default;
      return !exists(settingsPath) ||
        get(settingsPath).data.allowPublicRegistration == true;
    }

    function userExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return userExists() && userData().status == 'ACTIVE';
    }

    function staffDocExists(gymId) {
      return exists(/databases/$(database)/documents/gyms/$(gymId)/staff/$(request.auth.uid));
    }

    function staffDocData(gymId) {
      return get(/databases/$(database)/documents/gyms/$(gymId)/staff/$(request.auth.uid)).data;
    }

    function isGymOwnerUid(uid, gymId) {
      let uPath = /databases/$(database)/documents/users/$(uid);
      let u = exists(uPath) ? get(uPath).data : null;
      return u != null && u.status == 'ACTIVE' && ('gymId' in u) && u.gymId == gymId && u.role == 'GYM_OWNER';
    }

    function isGymOwner(gymId) {
      return isSignedIn() && isGymOwnerUid(request.auth.uid, gymId);
    }

    function isGymStaff(gymId) {
      return isActiveUser() && userData().gymId == gymId && (
        userData().role == 'GYM_OWNER' ||
        (userData().role in ['GYM_MANAGER', 'GYM_RECEPTIONIST', 'GYM_TRAINER'] &&
         staffDocExists(gymId) &&
         staffDocData(gymId).status == 'ACTIVE')
      );
    }

    function staffPathHasPerm(sPath, permKey) {
      let s = exists(sPath) ? get(sPath).data : null;
      return s != null && s.status == 'ACTIVE' &&
        ('permissions' in s) && (permKey in s.permissions) && s.permissions[permKey] == true;
    }

    function staffHasPermUid(uid, gymId, permKey) {
      let uPath = /databases/$(database)/documents/users/$(uid);
      let u = exists(uPath) ? get(uPath).data : null;
      let sPath = /databases/$(database)/documents/gyms/$(gymId)/staff/$(uid);
      return u != null && u.status == 'ACTIVE' && ('gymId' in u) && u.gymId == gymId && (
        u.role == 'GYM_OWNER' || (
          u.role in ['GYM_MANAGER', 'GYM_RECEPTIONIST', 'GYM_TRAINER'] &&
          staffPathHasPerm(sPath, permKey)
        )
      );
    }

    function staffHasPerm(gymId, permKey) {
      return isSignedIn() && staffHasPermUid(request.auth.uid, gymId, permKey);
    }

    function staffHasAny2(gymId, k1, k2) {
      let uPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let u = isSignedIn() && exists(uPath) ? get(uPath).data : null;
      let sPath = /databases/$(database)/documents/gyms/$(gymId)/staff/$(request.auth.uid);
      let s = (u != null && u.role in ['GYM_MANAGER', 'GYM_RECEPTIONIST', 'GYM_TRAINER'] && exists(sPath))
        ? get(sPath).data
        : null;
      return u != null && u.status == 'ACTIVE' && ('gymId' in u) && u.gymId == gymId && (
        u.role == 'GYM_OWNER' || (
          s != null && s.status == 'ACTIVE' && ('permissions' in s) && (
            ((k1 in s.permissions) && s.permissions[k1] == true) ||
            ((k2 in s.permissions) && s.permissions[k2] == true)
          )
        )
      );
    }

    function staffHasAny3(gymId, k1, k2, k3) {
      let uPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let u = isSignedIn() && exists(uPath) ? get(uPath).data : null;
      let sPath = /databases/$(database)/documents/gyms/$(gymId)/staff/$(request.auth.uid);
      let s = (u != null && u.role in ['GYM_MANAGER', 'GYM_RECEPTIONIST', 'GYM_TRAINER'] && exists(sPath))
        ? get(sPath).data
        : null;
      return u != null && u.status == 'ACTIVE' && ('gymId' in u) && u.gymId == gymId && (
        u.role == 'GYM_OWNER' || (
          s != null && s.status == 'ACTIVE' && ('permissions' in s) && (
            ((k1 in s.permissions) && s.permissions[k1] == true) ||
            ((k2 in s.permissions) && s.permissions[k2] == true) ||
            ((k3 in s.permissions) && s.permissions[k3] == true)
          )
        )
      );
    }

    function staffHasAny4(gymId, k1, k2, k3, k4) {
      let uPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let u = isSignedIn() && exists(uPath) ? get(uPath).data : null;
      let sPath = /databases/$(database)/documents/gyms/$(gymId)/staff/$(request.auth.uid);
      let s = (u != null && u.role in ['GYM_MANAGER', 'GYM_RECEPTIONIST', 'GYM_TRAINER'] && exists(sPath))
        ? get(sPath).data
        : null;
      return u != null && u.status == 'ACTIVE' && ('gymId' in u) && u.gymId == gymId && (
        u.role == 'GYM_OWNER' || (
          s != null && s.status == 'ACTIVE' && ('permissions' in s) && (
            ((k1 in s.permissions) && s.permissions[k1] == true) ||
            ((k2 in s.permissions) && s.permissions[k2] == true) ||
            ((k3 in s.permissions) && s.permissions[k3] == true) ||
            ((k4 in s.permissions) && s.permissions[k4] == true)
          )
        )
      );
    }

    function gymExists(gymId) {
      return exists(/databases/$(database)/documents/gyms/$(gymId));
    }

    function isGymActive(gymId) {
      let gymPath = /databases/$(database)/documents/gyms/$(gymId);
      let gym = exists(gymPath) ? get(gymPath).data : null;
      return gym != null &&
        gym.accountStatus == 'ACTIVE' &&
        gym.subscriptionStatus in ['TRIAL', 'ACTIVE'] &&
        ('subscriptionAccessUntil' in gym) &&
        gym.subscriptionAccessUntil is timestamp &&
        gym.subscriptionAccessUntil > request.time;
    }

    function isGymActiveAfter(gymId) {
      let gymPath = /databases/$(database)/documents/gyms/$(gymId);
      let gym = existsAfter(gymPath) ? getAfter(gymPath).data : null;
      return gym != null &&
        gym.accountStatus == 'ACTIVE' &&
        gym.subscriptionStatus in ['TRIAL', 'ACTIVE'] &&
        ('subscriptionAccessUntil' in gym) &&
        gym.subscriptionAccessUntil is timestamp &&
        gym.subscriptionAccessUntil > request.time;
    }

    function isValidSelfRegisteredGymSubscription(data) {
      let planPath = /databases/$(database)/documents/subscription_plans/$(data.subscriptionPlanId);
      let plan = exists(planPath) ? get(planPath).data : null;
      let trialDays = (plan != null && plan.trialDays > 0) ? plan.trialDays : 14;
      return plan != null &&
        plan.isActive == true &&
        data.gracePeriodDays >= 0 &&
        data.gracePeriodDays <= 30 && (
          (data.subscriptionStatus == 'PENDING' && data.subscriptionAccessUntil <= request.time) ||
          (data.subscriptionStatus == 'TRIAL' &&
            data.subscriptionAccessUntil > request.time &&
            data.subscriptionAccessUntil <= request.time + duration.value(trialDays + data.gracePeriodDays + 2, 'd'))
        );
    }

    function isOptString(data, key, maxLen) {
      return !(key in data) || (data[key] is string && data[key].size() <= maxLen);
    }

    function isOptNumber(data, key, minVal, maxVal) {
      return !(key in data) || (data[key] is number && data[key] >= minVal && data[key] <= maxVal);
    }

    function isOptInt(data, key, minVal, maxVal) {
      return !(key in data) || (data[key] is int && data[key] >= minVal && data[key] <= maxVal);
    }

    function isOptBool(data, key) {
      return !(key in data) || (data[key] is bool);
    }

    function isOptIntList(data, key, maxLen) {
      return !(key in data) || (
        data[key] is list &&
        data[key].size() <= maxLen &&
        (data[key].size() == 0 || data[key][0] is int)
      );
    }

    function isAcceptedInviteDocForUser(inv, gymId, role) {
      return emailMatches(inv.email) &&
        inv.gymId == gymId &&
        inv.role == role &&
        inv.status == 'ACCEPTED' &&
        inv.acceptedByUid == request.auth.uid &&
        (!('expiresAt' in inv) || inv.expiresAt > request.time);
    }

    function isAcceptedInviteForUser(invitationId, gymId, role) {
      let invPath = /databases/$(database)/documents/invitations/$(invitationId);
      return isValidId(invitationId) &&
        exists(invPath) &&
        get(invPath).data.status == 'PENDING' &&
        isAcceptedInviteDocForUser(
          getAfter(invPath).data,
          gymId,
          role
        );
    }

    function isPendingGymOwnerAfter(gymId) {
      let gym = getAfter(/databases/$(database)/documents/gyms/$(gymId)).data;
      return gym.ownerUid == request.auth.uid && gym.accountStatus == 'ACTIVE';
    }

    function isUserActiveInGymAfter(gymId) {
      let u = getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return u.gymId == gymId && u.status == 'ACTIVE';
    }

    function isValidPermissionsMap(perms) {
      return perms is map &&
        perms.keys().hasOnly([
          'canViewMembers', 'canManageMembers',
          'canViewReports', 'canViewPayments', 'canRecordPayments',
          'canManagePlans', 'canConfirmPayments', 'canDeleteMembers',
          'canManageReminders', 'canManageAttendance'
        ]) &&
        isOptBool(perms, 'canViewMembers') &&
        isOptBool(perms, 'canManageMembers') &&
        isOptBool(perms, 'canViewReports') &&
        isOptBool(perms, 'canViewPayments') &&
        isOptBool(perms, 'canRecordPayments') &&
        isOptBool(perms, 'canManagePlans') &&
        isOptBool(perms, 'canConfirmPayments') &&
        isOptBool(perms, 'canDeleteMembers') &&
        isOptBool(perms, 'canManageReminders') &&
        isOptBool(perms, 'canManageAttendance');
    }

    // -------------------------------------------------------------------------
    // Validation Blueprints (Anti-Update-Gap)
    // -------------------------------------------------------------------------
    function isValidPlatformAdmin(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'createdAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.createdAt is timestamp;
    }

    function isValidPlatformSettings(data) {
      return data.keys().hasAll([
          'supportEmail', 'supportPhone', 'upiId', 'upiPayeeName',
          'paymentInstructions', 'defaultGracePeriodDays', 'allowPublicRegistration', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'supportEmail', 'supportPhone', 'upiId', 'upiPayeeName',
          'paymentInstructions', 'defaultGracePeriodDays', 'allowPublicRegistration', 'updatedAt'
        ]) &&
        data.supportEmail is string && data.supportEmail.size() >= 3 && data.supportEmail.size() <= 200 &&
        data.supportPhone is string && data.supportPhone.size() >= 3 && data.supportPhone.size() <= 40 &&
        data.upiId is string && data.upiId.size() <= 120 &&
        data.upiPayeeName is string && data.upiPayeeName.size() <= 120 &&
        data.paymentInstructions is string && data.paymentInstructions.size() <= 1000 &&
        data.defaultGracePeriodDays is int && data.defaultGracePeriodDays >= 0 && data.defaultGracePeriodDays <= 90 &&
        data.allowPublicRegistration is bool &&
        data.updatedAt is timestamp;
    }

    function isValidSubscriptionPlan(data) {
      return data.keys().hasAll([
          'id', 'name', 'billingDurationMonths', 'price', 'currency',
          'maxStaff', 'maxMembers', 'trialDays', 'features', 'isActive', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'billingDurationMonths', 'price', 'currency',
          'maxStaff', 'maxMembers', 'trialDays', 'features', 'isActive', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
        data.billingDurationMonths is int && data.billingDurationMonths >= 1 && data.billingDurationMonths <= 60 &&
        data.price is number && data.price >= 0 && data.price <= 10000000 &&
        data.currency is string && data.currency.size() >= 1 && data.currency.size() <= 8 &&
        data.maxStaff is int && data.maxStaff >= 1 && data.maxStaff <= 1000 &&
        data.maxMembers is int && data.maxMembers >= 1 && data.maxMembers <= 100000 &&
        data.trialDays is int && data.trialDays >= 0 && data.trialDays <= 90 &&
        data.features is list && data.features.size() <= 12 &&
        (data.features.size() == 0 || (data.features[0] is string && data.features[0].size() <= 120)) &&
        data.isActive is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'status', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'gymId', 'invitationId', 'status', 'createdAt', 'updatedAt']) &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
        data.role in ['SUPER_ADMIN', 'GYM_OWNER', 'GYM_MANAGER', 'GYM_RECEPTIONIST', 'GYM_TRAINER'] &&
        isOptString(data, 'gymId', 128) &&
        isOptString(data, 'invitationId', 128) &&
        data.status in ['ACTIVE', 'DEACTIVATED'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidGym(data) {
      return data.keys().hasAll([
          'id', 'name', 'ownerUid', 'ownerName', 'email', 'phone',
          'accountStatus', 'subscriptionStatus', 'subscriptionPlanId', 'subscriptionPlanName',
          'subscriptionStartAt', 'subscriptionEndAt', 'subscriptionAccessUntil',
          'gracePeriodDays', 'renewalPolicy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'ownerUid', 'ownerName', 'email', 'phone', 'address',
          'accountStatus', 'subscriptionStatus', 'subscriptionPlanId', 'subscriptionPlanName',
          'subscriptionStartAt', 'subscriptionEndAt', 'subscriptionAccessUntil', 'ownerInvitationId',
          'gracePeriodDays', 'renewalPolicy', 'suspensionReason', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 120 &&
        isValidId(data.ownerUid) &&
        data.ownerName is string && data.ownerName.size() >= 2 && data.ownerName.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 40 &&
        isOptString(data, 'address', 300) &&
        data.accountStatus in ['ACTIVE', 'SUSPENDED'] &&
        data.subscriptionStatus in ['TRIAL', 'ACTIVE', 'EXPIRED', 'PENDING', 'CANCELLED'] &&
        isValidId(data.subscriptionPlanId) &&
        data.subscriptionPlanName is string && data.subscriptionPlanName.size() >= 1 && data.subscriptionPlanName.size() <= 80 &&
        data.subscriptionStartAt is string && data.subscriptionStartAt.size() <= 40 &&
        data.subscriptionEndAt is string && data.subscriptionEndAt.size() <= 40 &&
        data.subscriptionAccessUntil is timestamp &&
        isOptString(data, 'ownerInvitationId', 128) &&
        data.gracePeriodDays is int && data.gracePeriodDays >= 0 && data.gracePeriodDays <= 90 &&
        data.renewalPolicy in ['EXTEND_FROM_EXPIRY', 'START_TODAY_IF_EXPIRED'] &&
        isOptString(data, 'suspensionReason', 400) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSubscriptionPayment(data) {
      return data.keys().hasAll([
          'id', 'gymId', 'gymName', 'ownerUid', 'planId', 'planName', 'amount', 'paymentMode',
          'idempotencyKey', 'paymentDate', 'periodStart', 'periodEnd', 'status',
          'recordedByUid', 'extensionApplied', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'gymId', 'gymName', 'ownerUid', 'planId', 'planName', 'amount', 'paymentMode',
          'transactionReference', 'idempotencyKey', 'paymentDate', 'periodStart', 'periodEnd',
          'status', 'notes', 'recordedByUid', 'verifiedByUid', 'extensionApplied', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.gymId) &&
        data.gymName is string && data.gymName.size() >= 1 && data.gymName.size() <= 120 &&
        isValidId(data.ownerUid) &&
        isValidId(data.planId) &&
        data.planName is string && data.planName.size() >= 1 && data.planName.size() <= 80 &&
        data.amount is number && data.amount >= 0 && data.amount <= 10000000 &&
        data.paymentMode in ['CASH', 'UPI'] &&
        isOptString(data, 'transactionReference', 120) &&
        isValidId(data.idempotencyKey) &&
        data.paymentDate is string && data.paymentDate.size() <= 32 &&
        data.periodStart is string && data.periodStart.size() <= 32 &&
        data.periodEnd is string && data.periodEnd.size() <= 32 &&
        data.status in ['PENDING', 'RECORDED', 'VERIFIED', 'REJECTED'] &&
        isOptString(data, 'notes', 500) &&
        isValidId(data.recordedByUid) &&
        isOptString(data, 'verifiedByUid', 128) &&
        data.extensionApplied is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidGymSettings(data, gymId) {
      return data.keys().hasAll([
          'gymId', 'gracePeriodDays', 'renewalPolicy', 'reminderDaysBefore',
          'sendOnExpiryDay', 'sendAfterExpiryDays', 'emailEnabled', 'inAppEnabled',
          'whatsappEnabled', 'currencySymbol', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'gymId', 'gracePeriodDays', 'renewalPolicy', 'reminderDaysBefore',
          'sendOnExpiryDay', 'sendAfterExpiryDays', 'paymentRemindersEnabled',
          'upcomingPaymentReminderDays', 'overduePaymentReminderDays', 'ownerSubReminderDays',
          'lastReminderRunDate', 'emailEnabled', 'emailFromName',
          'inAppEnabled', 'whatsappEnabled', 'whatsappPhoneNumberId',
          'whatsappApprovedTemplate', 'currencySymbol', 'updatedAt'
        ]) &&
        data.gymId == gymId &&
        data.gracePeriodDays is int && data.gracePeriodDays >= 0 && data.gracePeriodDays <= 90 &&
        data.renewalPolicy in ['EXTEND_FROM_EXPIRY', 'START_TODAY_IF_EXPIRED'] &&
        data.reminderDaysBefore is list && data.reminderDaysBefore.size() <= 10 &&
        (data.reminderDaysBefore.size() == 0 || data.reminderDaysBefore[0] is int) &&
        data.sendOnExpiryDay is bool &&
        data.sendAfterExpiryDays is list && data.sendAfterExpiryDays.size() <= 10 &&
        (data.sendAfterExpiryDays.size() == 0 || data.sendAfterExpiryDays[0] is int) &&
        isOptBool(data, 'paymentRemindersEnabled') &&
        isOptInt(data, 'upcomingPaymentReminderDays', 0, 30) &&
        isOptIntList(data, 'overduePaymentReminderDays', 10) &&
        isOptIntList(data, 'ownerSubReminderDays', 10) &&
        isOptString(data, 'lastReminderRunDate', 20) &&
        data.emailEnabled is bool &&
        isOptString(data, 'emailFromName', 120) &&
        data.inAppEnabled is bool &&
        data.whatsappEnabled is bool &&
        isOptString(data, 'whatsappPhoneNumberId', 100) &&
        isOptString(data, 'whatsappApprovedTemplate', 120) &&
        data.currencySymbol is string && data.currencySymbol.size() >= 1 && data.currencySymbol.size() <= 8 &&
        data.updatedAt is timestamp;
    }

    function isValidGymStaff(data, gymId) {
      return data.keys().hasAll([
          'id', 'gymId', 'email', 'fullName', 'role', 'status', 'permissions', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'gymId', 'uid', 'invitationId', 'email', 'fullName', 'phone',
          'role', 'roleTitle', 'status', 'permissions', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.gymId == gymId &&
        isOptString(data, 'uid', 128) &&
        isOptString(data, 'invitationId', 128) &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120 &&
        isOptString(data, 'phone', 40) &&
        data.role in ['GYM_OWNER', 'GYM_MANAGER', 'GYM_RECEPTIONIST', 'GYM_TRAINER'] &&
        isOptString(data, 'roleTitle', 64) &&
        data.status in ['ACTIVE', 'DEACTIVATED'] &&
        isValidPermissionsMap(data.permissions) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidInvitation(data) {
      return data.keys().hasAll([
          'id', 'gymId', 'gymName', 'email', 'fullName', 'role', 'permissions',
          'status', 'invitedByUid', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'gymId', 'gymName', 'email', 'fullName', 'role', 'roleTitle', 'permissions',
          'status', 'invitedByUid', 'acceptedByUid', 'expiresAt', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.gymId) &&
        data.gymName is string && data.gymName.size() >= 1 && data.gymName.size() <= 120 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 200 &&
        data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 120 &&
        data.role in ['GYM_OWNER', 'GYM_MANAGER', 'GYM_RECEPTIONIST', 'GYM_TRAINER'] &&
        isOptString(data, 'roleTitle', 64) &&
        isValidPermissionsMap(data.permissions) &&
        data.status in ['PENDING', 'ACCEPTED', 'REVOKED'] &&
        isValidId(data.invitedByUid) &&
        isOptString(data, 'acceptedByUid', 128) &&
        (!('expiresAt' in data) || data.expiresAt is timestamp) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMember(data, gymId) {
      return data.keys().hasAll([
          'id', 'gymId', 'memberCode', 'fullName', 'phone', 'joiningDate',
          'membershipStatus', 'outstandingBalance', 'reminderOptOut', 'isArchived', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'gymId', 'memberCode', 'fullName', 'phone', 'email', 'gender', 'dateOfBirth',
          'address', 'joiningDate', 'emergencyContact', 'currentPlanId', 'currentPlanName',
          'membershipStartDate', 'membershipExpiryDate', 'membershipStatus', 'outstandingBalance',
          'reminderOptOut', 'notes', 'isArchived', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.gymId == gymId &&
        data.memberCode is string && data.memberCode.size() >= 2 && data.memberCode.size() <= 32 &&
        data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 120 &&
        data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 30 &&
        isOptString(data, 'email', 200) &&
        isOptString(data, 'gender', 32) &&
        isOptString(data, 'dateOfBirth', 20) &&
        isOptString(data, 'address', 300) &&
        data.joiningDate is string && data.joiningDate.size() <= 20 &&
        isOptString(data, 'emergencyContact', 120) &&
        isOptString(data, 'currentPlanId', 128) &&
        isOptString(data, 'currentPlanName', 100) &&
        isOptString(data, 'membershipStartDate', 20) &&
        isOptString(data, 'membershipExpiryDate', 20) &&
        data.membershipStatus in ['ACTIVE', 'EXPIRING_SOON', 'EXPIRED', 'CANCELLED', 'NONE'] &&
        data.outstandingBalance is number && data.outstandingBalance >= 0 && data.outstandingBalance <= 10000000 &&
        data.reminderOptOut is bool &&
        isOptString(data, 'notes', 1000) &&
        data.isArchived is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMembershipPlan(data, gymId) {
      return data.keys().hasAll([
          'id', 'gymId', 'name', 'durationType', 'durationValue', 'price',
          'benefits', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'gymId', 'name', 'durationType', 'durationValue', 'price',
          'description', 'benefits', 'status', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.gymId == gymId &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 100 &&
        data.durationType in ['MONTHLY', 'QUARTERLY', 'HALF_YEARLY', 'YEARLY', 'CUSTOM_DAYS'] &&
        data.durationValue is int && data.durationValue >= 1 && data.durationValue <= 3650 &&
        data.price is number && data.price >= 0 && data.price <= 10000000 &&
        isOptString(data, 'description', 400) &&
        data.benefits is list && data.benefits.size() <= 12 &&
        (data.benefits.size() == 0 || (data.benefits[0] is string && data.benefits[0].size() <= 120)) &&
        data.status in ['ACTIVE', 'INACTIVE'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMembership(data, gymId) {
      return data.keys().hasAll([
          'id', 'gymId', 'memberId', 'memberName', 'planId', 'planName', 'actionType',
          'startDate', 'expiryDate', 'planPrice', 'amountPaid', 'balanceDue', 'status',
          'recordedByUid', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'gymId', 'memberId', 'memberName', 'planId', 'planName', 'actionType',
          'startDate', 'expiryDate', 'planPrice', 'discountAmount', 'discountReason',
          'amountPaid', 'balanceDue', 'dueDate', 'status',
          'recordedByUid', 'cancelledAt', 'cancellationReason', 'notes', 'createdAt', 'updatedAt'
        ]) &&
        isValidId(data.id) &&
        data.gymId == gymId &&
        isValidId(data.memberId) &&
        data.memberName is string && data.memberName.size() >= 1 && data.memberName.size() <= 120 &&
        isValidId(data.planId) &&
        data.planName is string && data.planName.size() >= 1 && data.planName.size() <= 100 &&
        data.actionType in ['INITIAL', 'RENEWAL', 'UPGRADE', 'DOWNGRADE', 'MANUAL_EXTENSION'] &&
        data.startDate is string && data.startDate.size() <= 20 &&
        data.expiryDate is string && data.expiryDate.size() <= 20 &&
        data.planPrice is number && data.planPrice >= 0 && data.planPrice <= 10000000 &&
        isOptNumber(data, 'discountAmount', 0, 10000000) &&
        isOptString(data, 'discountReason', 200) &&
        data.amountPaid is number && data.amountPaid >= 0 && data.amountPaid <= 10000000 &&
        data.balanceDue is number && data.balanceDue >= 0 && data.balanceDue <= 10000000 &&
        isOptString(data, 'dueDate', 20) &&
        data.status in ['ACTIVE', 'EXPIRED', 'SUPERSEDED', 'CANCELLED'] &&
        isValidId(data.recordedByUid) &&
        isOptString(data, 'cancelledAt', 32) &&
        isOptString(data, 'cancellationReason', 300) &&
        isOptString(data, 'notes', 500) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidMemberPayment(data, gymId) {
      let d = data;
      let k = d.keys();
      return k.hasAll([
          'id', 'paymentCode', 'gymId', 'memberId', 'memberName', 'amount',
          'paymentMode', 'paymentPurpose', 'paymentDate', 'status',
          'recordedByUid', 'recordedByName', 'createdAt', 'updatedAt'
        ]) &&
        k.hasOnly([
          'id', 'paymentCode', 'gymId', 'memberId', 'memberName', 'membershipId', 'amount',
          'discountAmount', 'discountReason', 'paymentMode', 'paymentPurpose',
          'transactionReference', 'attachmentName', 'paymentDate', 'dueDate',
          'status', 'recordedByUid', 'recordedByName', 'confirmedByUid',
          'receiptNumber', 'notes', 'createdAt', 'updatedAt'
        ]) &&
        d.id is string && d.id.size() >= 1 && d.id.size() <= 128 &&
        d.paymentCode is string && d.paymentCode.size() >= 3 && d.paymentCode.size() <= 40 &&
        d.gymId == gymId &&
        isValidId(d.memberId) &&
        d.memberName is string && d.memberName.size() >= 1 && d.memberName.size() <= 120 &&
        isOptString(d, 'membershipId', 128) &&
        d.amount is number && d.amount > 0 && d.amount <= 10000000 &&
        isOptNumber(d, 'discountAmount', 0, 10000000) &&
        isOptString(d, 'discountReason', 200) &&
        d.paymentMode in ['CASH', 'UPI'] &&
        d.paymentPurpose in ['MEMBERSHIP', 'RENEWAL', 'BALANCE_SETTLEMENT', 'ADVANCE'] &&
        isOptString(d, 'transactionReference', 120) &&
        isOptString(d, 'attachmentName', 160) &&
        d.paymentDate is string && d.paymentDate.size() <= 20 &&
        isOptString(d, 'dueDate', 20) &&
        d.status in ['PENDING', 'CONFIRMED', 'REJECTED', 'REFUNDED'] &&
        d.recordedByUid is string && d.recordedByUid.size() >= 1 && d.recordedByUid.size() <= 128 &&
        d.recordedByName is string && d.recordedByName.size() >= 1 && d.recordedByName.size() <= 120 &&
        isOptString(d, 'confirmedByUid', 128) &&
        isOptString(d, 'receiptNumber', 48) &&
        isOptString(d, 'notes', 500) &&
        d.createdAt is timestamp &&
        d.updatedAt is timestamp;
    }

    function isValidPaymentReceipt(data, gymId) {
      return data.keys().hasAll([
          'id', 'receiptNumber', 'gymId', 'gymName', 'paymentId', 'memberId',
          'memberName', 'memberCode', 'amount', 'paymentMode', 'issuedAt', 'issuedByUid'
        ]) &&
        data.keys().hasOnly([
          'id', 'receiptNumber', 'gymId', 'gymName', 'paymentId', 'memberId',
          'memberName', 'memberCode', 'amount', 'paymentMode', 'transactionReference',
          'issuedAt', 'issuedByUid'
        ]) &&
        isValidId(data.id) &&
        data.receiptNumber is string && data.receiptNumber.size() >= 3 && data.receiptNumber.size() <= 48 &&
        data.gymId == gymId &&
        data.gymName is string && data.gymName.size() >= 1 && data.gymName.size() <= 120 &&
        isValidId(data.paymentId) &&
        isValidId(data.memberId) &&
        data.memberName is string && data.memberName.size() >= 1 && data.memberName.size() <= 120 &&
        data.memberCode is string && data.memberCode.size() >= 2 && data.memberCode.size() <= 32 &&
        data.amount is number && data.amount > 0 && data.amount <= 10000000 &&
        data.paymentMode in ['CASH', 'UPI'] &&
        isOptString(data, 'transactionReference', 120) &&
        data.issuedAt is timestamp &&
        isValidId(data.issuedByUid);
    }

    function isValidAttendanceRecord(data, gymId) {
      let d = data;
      let k = d.keys();
      return k.hasAll([
          'id', 'gymId', 'memberId', 'memberCode', 'memberName',
          'checkInDate', 'checkInTime', 'recordedByUid', 'recordedByName', 'createdAt'
        ]) &&
        k.hasOnly([
          'id', 'gymId', 'memberId', 'memberCode', 'memberName',
          'checkInDate', 'checkInTime', 'checkOutTime', 'recordedByUid', 'recordedByName',
          'notes', 'createdAt'
        ]) &&
        isValidId(d.id) &&
        d.gymId == gymId &&
        isValidId(d.memberId) &&
        d.memberCode is string && d.memberCode.size() >= 2 && d.memberCode.size() <= 32 &&
        d.memberName is string && d.memberName.size() >= 1 && d.memberName.size() <= 120 &&
        d.checkInDate is string && d.checkInDate.size() <= 20 &&
        d.checkInTime is string && d.checkInTime.size() <= 40 &&
        isOptString(d, 'checkOutTime', 40) &&
        isValidId(d.recordedByUid) &&
        d.recordedByName is string && d.recordedByName.size() >= 1 && d.recordedByName.size() <= 120 &&
        isOptString(d, 'notes', 300) &&
        d.createdAt is timestamp;
    }

    function isValidGymNotification(data, gymId) {
      return data.keys().hasAll(['id', 'gymId', 'type', 'title', 'message', 'isRead', 'createdAt']) &&
        data.keys().hasOnly(['id', 'gymId', 'type', 'title', 'message', 'isRead', 'createdAt']) &&
        isValidId(data.id) &&
        data.gymId == gymId &&
        data.type is string && data.type.size() >= 1 && data.type.size() <= 64 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 500 &&
        data.isRead is bool &&
        data.createdAt is timestamp;
    }

    function isValidPlatformNotification(data) {
      return data.keys().hasAll(['id', 'type', 'title', 'message', 'isRead', 'createdAt']) &&
        data.keys().hasOnly(['id', 'type', 'title', 'message', 'gymId', 'isRead', 'createdAt']) &&
        isValidId(data.id) &&
        data.type is string && data.type.size() >= 1 && data.type.size() <= 64 &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
        data.message is string && data.message.size() >= 1 && data.message.size() <= 500 &&
        isOptString(data, 'gymId', 128) &&
        data.isRead is bool &&
        data.createdAt is timestamp;
    }

    function isValidNotificationLog(data, gymId) {
      let d = data;
      let k = d.keys();
      return k.hasAll([
          'id', 'gymId', 'memberId', 'memberName', 'recipient', 'channel',
          'template', 'dedupKey', 'scheduledDate', 'deliveryStatus', 'retryCount', 'createdAt', 'updatedAt'
        ]) &&
        k.hasOnly([
          'id', 'gymId', 'memberId', 'memberName', 'recipient', 'channel', 'category',
          'template', 'dedupKey', 'scheduledDate', 'deliveryStatus', 'retryCount',
          'errorDetails', 'providerMessageId', 'sentAt', 'lastAttemptAt', 'nextRetryAt',
          'createdAt', 'updatedAt'
        ]) &&
        isValidId(d.id) &&
        d.gymId == gymId &&
        isValidId(d.memberId) &&
        d.memberName is string && d.memberName.size() >= 1 && d.memberName.size() <= 120 &&
        d.recipient is string && d.recipient.size() >= 1 && d.recipient.size() <= 200 &&
        d.channel in ['EMAIL', 'IN_APP', 'WHATSAPP_CLOUD'] &&
        (!('category' in d) || d.category in ['MEMBERSHIP_EXPIRY', 'UPCOMING_PAYMENT', 'OVERDUE_PAYMENT', 'SUBSCRIPTION_EXPIRY']) &&
        d.template is string && d.template.size() >= 1 && d.template.size() <= 80 &&
        d.dedupKey is string && d.dedupKey.size() >= 3 && d.dedupKey.size() <= 160 &&
        d.scheduledDate is string && d.scheduledDate.size() <= 20 &&
        d.deliveryStatus in ['SENT', 'FAILED', 'RETRY_SCHEDULED', 'SKIPPED_OPT_OUT'] &&
        d.retryCount is int && d.retryCount >= 0 && d.retryCount <= 10 &&
        isOptString(d, 'errorDetails', 400) &&
        isOptString(d, 'providerMessageId', 200) &&
        isOptString(d, 'sentAt', 40) &&
        isOptString(d, 'lastAttemptAt', 40) &&
        isOptString(d, 'nextRetryAt', 40) &&
        d.createdAt is timestamp &&
        d.updatedAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll([
          'id', 'actorUid', 'actorEmail', 'actorRole', 'action', 'entityType', 'entityId', 'summary', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'actorUid', 'actorEmail', 'actorRole', 'gymId', 'action', 'entityType', 'entityId', 'summary', 'createdAt'
        ]) &&
        isValidId(data.id) &&
        isValidId(data.actorUid) &&
        data.actorEmail is string && data.actorEmail.size() >= 3 && data.actorEmail.size() <= 200 &&
        data.actorRole is string && data.actorRole.size() >= 2 && data.actorRole.size() <= 40 &&
        isOptString(data, 'gymId', 128) &&
        data.action is string && data.action.size() >= 2 && data.action.size() <= 80 &&
        data.entityType is string && data.entityType.size() >= 2 && data.entityType.size() <= 64 &&
        data.entityId is string && data.entityId.size() >= 1 && data.entityId.size() <= 128 &&
        data.summary is string && data.summary.size() >= 2 && data.summary.size() <= 300 &&
        data.createdAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collections & Master Gate Rules
    // -------------------------------------------------------------------------
    match /platform_bootstrap/{docId} {
      allow read, write: if false;
    }

    match /system_locks/{lockId} {
      allow read, write: if false;
    }

    match /platform_admins/{uid} {
      allow get: if isValidId(uid) && (isSuperAdmin() || (isSignedIn() && request.auth.uid == uid));
      allow list: if isSuperAdmin();
      allow create: if isValidId(uid) && isSuperAdmin() &&
        isValidPlatformAdmin(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().uid == uid;
      allow update: if false;
      allow delete: if isValidId(uid) && isSuperAdmin() && request.auth.uid != uid;
    }

    match /platform_settings/{settingId} {
      allow get: if isValidId(settingId) && isSignedIn();
      allow list: if isSuperAdmin();
      allow create: if isValidId(settingId) && isSuperAdmin() &&
        isValidPlatformSettings(incoming()) &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(settingId) && isSuperAdmin() &&
        isValidPlatformSettings(incoming()) &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'supportEmail', 'supportPhone', 'upiId', 'upiPayeeName',
          'paymentInstructions', 'defaultGracePeriodDays', 'allowPublicRegistration', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /subscription_plans/{planId} {
      allow get: if isValidId(planId) && isSignedIn();
      allow list: if isSignedIn();
      allow create: if isValidId(planId) && isSuperAdmin() &&
        isValidSubscriptionPlan(incoming()) &&
        incoming().id == planId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(planId) && isSuperAdmin() &&
        isValidSubscriptionPlan(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'billingDurationMonths', 'price', 'currency',
          'maxStaff', 'maxMembers', 'trialDays', 'features', 'isActive', 'updatedAt'
        ]);
      allow delete: if isValidId(planId) && isSuperAdmin();
    }

    match /subscription_payments/{paymentId} {
      allow get: if isValidId(paymentId) && (
        isSuperAdmin() ||
        (isSignedIn() && existing().ownerUid == request.auth.uid)
      );
      allow list: if isSuperAdmin() || (isSignedIn() && existing().ownerUid == request.auth.uid);
      allow create: if isValidId(paymentId) && isSuperAdmin() &&
        isValidSubscriptionPayment(incoming()) &&
        incoming().id == paymentId &&
        incoming().recordedByUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(paymentId) && isSuperAdmin() &&
        isValidSubscriptionPayment(incoming()) &&
        existing().status in ['PENDING', 'RECORDED'] &&
        incoming().id == existing().id &&
        incoming().gymId == existing().gymId &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().idempotencyKey == existing().idempotencyKey &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'status', 'verifiedByUid', 'extensionApplied', 'notes', 'updatedAt'
        ]);
      allow delete: if false;
    }

    match /users/{uid} {
      allow get: if isValidId(uid) && (
        isSuperAdmin() ||
        (isSignedIn() && request.auth.uid == uid) ||
        (isActiveUser() && existing().gymId == userData().gymId && userData().role == 'GYM_OWNER')
      );
      allow list: if isSuperAdmin() || (isSignedIn() && existing().uid == request.auth.uid);
      allow create: if isValidId(uid) && isSignedIn() &&
        isValidUserProfile(incoming()) &&
        incoming().uid == uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          isSuperAdmin() ||
          (
            request.auth.uid == uid &&
            emailMatches(incoming().email) &&
            incoming().status == 'ACTIVE' && (
              (incoming().role == 'GYM_OWNER' &&
                ('gymId' in incoming()) &&
                isValidId(incoming().gymId) &&
                getAfter(/databases/$(database)/documents/gyms/$(incoming().gymId)).data.ownerUid == request.auth.uid && (
                  isPublicRegistrationAllowed() ||
                  (('invitationId' in incoming()) &&
                    isAcceptedInviteForUser(incoming().invitationId, incoming().gymId, 'GYM_OWNER'))
                )
              ) ||
              (incoming().role in ['GYM_MANAGER', 'GYM_RECEPTIONIST', 'GYM_TRAINER'] &&
                ('gymId' in incoming()) &&
                isValidId(incoming().gymId) &&
                ('invitationId' in incoming()) &&
                isGymActiveAfter(incoming().gymId) &&
                isAcceptedInviteForUser(incoming().invitationId, incoming().gymId, incoming().role)
              )
            )
          )
        );
      allow update: if isValidId(uid) && isSignedIn() &&
        isValidUserProfile(incoming()) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (isSuperAdmin() && incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName', 'status', 'role', 'gymId', 'updatedAt'
          ])) ||
          (request.auth.uid == uid &&
            incoming().role == existing().role &&
            ((!('gymId' in existing()) && !('gymId' in incoming())) ||
             (('gymId' in existing()) && ('gymId' in incoming()) && incoming().gymId == existing().gymId)) &&
            incoming().status == existing().status &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
          ) ||
          (isGymOwner(existing().gymId) &&
            isGymActive(existing().gymId) &&
            existing().role in ['GYM_MANAGER', 'GYM_RECEPTIONIST', 'GYM_TRAINER'] &&
            incoming().role in ['GYM_MANAGER', 'GYM_RECEPTIONIST', 'GYM_TRAINER'] &&
            incoming().gymId == existing().gymId &&
            incoming().diff(existing()).affectedKeys().hasOnly(['role', 'status', 'displayName', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    match /invitations/{invitationId} {
      allow get: if isValidId(invitationId) && (
        isSuperAdmin() ||
        (isSignedIn() && (emailMatches(existing().email) || existing().invitedByUid == request.auth.uid))
      );
      allow list: if isSuperAdmin() || (
        isSignedIn() && (emailMatches(existing().email) || existing().invitedByUid == request.auth.uid)
      );
      allow create: if isValidId(invitationId) && isSignedIn() &&
        isValidInvitation(incoming()) &&
        incoming().id == invitationId &&
        incoming().status == 'PENDING' &&
        incoming().invitedByUid == request.auth.uid &&
        ('expiresAt' in incoming()) &&
        incoming().expiresAt is timestamp &&
        incoming().expiresAt > request.time &&
        incoming().expiresAt <= request.time + duration.value(30, 'd') &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          isSuperAdmin() ||
          (incoming().role != 'GYM_OWNER' && isGymOwner(incoming().gymId) && isGymActive(incoming().gymId))
        );
      allow update: if isValidId(invitationId) && isSignedIn() &&
        isValidInvitation(incoming()) &&
        existing().status == 'PENDING' &&
        incoming().id == existing().id &&
        incoming().gymId == existing().gymId &&
        incoming().email == existing().email &&
        incoming().role == existing().role &&
        incoming().permissions == existing().permissions &&
        incoming().invitedByUid == existing().invitedByUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (emailMatches(existing().email) &&
            (!('expiresAt' in existing()) || existing().expiresAt > request.time) &&
            incoming().status == 'ACCEPTED' &&
            incoming().acceptedByUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'acceptedByUid', 'updatedAt']) && (
              (existing().role == 'GYM_OWNER' &&
                gymExists(existing().gymId) &&
                get(/databases/$(database)/documents/gyms/$(existing().gymId)).data.accountStatus == 'ACTIVE') ||
              (existing().role != 'GYM_OWNER' && isGymActive(existing().gymId))
            )
          ) ||
          ((isSuperAdmin() || (isGymOwner(existing().gymId) && existing().role != 'GYM_OWNER')) &&
            incoming().status == 'REVOKED' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    match /gyms/{gymId} {
      allow get: if isValidId(gymId) && (
        isSuperAdmin() ||
        (isSignedIn() && existing().ownerUid == request.auth.uid) ||
        isGymStaff(gymId)
      );
      allow list: if isSuperAdmin() || (isSignedIn() && existing().ownerUid == request.auth.uid);
      allow create: if isValidId(gymId) && isSignedIn() &&
        isValidGym(incoming()) &&
        incoming().id == gymId &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time && (
          isSuperAdmin() ||
          (
            isPublicRegistrationAllowed() &&
            incoming().ownerUid == request.auth.uid &&
            incoming().accountStatus == 'ACTIVE' &&
            incoming().subscriptionStatus in ['TRIAL', 'PENDING'] &&
            isValidSelfRegisteredGymSubscription(incoming())
          )
        );
      allow update: if isValidId(gymId) && isSignedIn() &&
        isValidGym(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time && (
          (isSuperAdmin() &&
            incoming().ownerUid == existing().ownerUid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'ownerName', 'email', 'phone', 'address',
              'accountStatus', 'subscriptionStatus', 'subscriptionPlanId', 'subscriptionPlanName',
              'subscriptionStartAt', 'subscriptionEndAt', 'subscriptionAccessUntil',
              'ownerInvitationId', 'gracePeriodDays', 'renewalPolicy', 'suspensionReason', 'updatedAt'
            ])
          ) ||
          (existing().ownerUid.matches('^owner_pending_.*$') &&
            incoming().ownerUid == request.auth.uid &&
            ('ownerInvitationId' in existing()) &&
            isAcceptedInviteForUser(existing().ownerInvitationId, gymId, 'GYM_OWNER') &&
            incoming().diff(existing()).affectedKeys().hasOnly(['ownerUid', 'updatedAt'])
          ) ||
          (isGymOwner(gymId) && isGymActive(gymId) &&
            incoming().ownerUid == existing().ownerUid &&
            incoming().accountStatus == existing().accountStatus &&
            incoming().subscriptionStatus == existing().subscriptionStatus &&
            incoming().subscriptionPlanId == existing().subscriptionPlanId &&
            incoming().subscriptionStartAt == existing().subscriptionStartAt &&
            incoming().subscriptionEndAt == existing().subscriptionEndAt &&
            incoming().subscriptionAccessUntil == existing().subscriptionAccessUntil &&
            incoming().gracePeriodDays == existing().gracePeriodDays &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'name', 'phone', 'address', 'renewalPolicy', 'updatedAt'
            ])
          )
        );
      allow delete: if false;

      // -----------------------------------------------------------------------
      // Tenant Subcollections (Master Gate + Suspension/Expiry Lock + RBAC)
      // -----------------------------------------------------------------------
      match /settings/{settingId} {
        allow get: if isValidId(gymId) && isValidId(settingId) && (
          isSuperAdmin() || (
            isGymActive(gymId) &&
            staffHasAny4(gymId, 'canManageReminders', 'canViewMembers', 'canManageMembers', 'canViewReports')
          )
        );
        allow list: if isSuperAdmin() || (
          isGymActive(gymId) &&
          existing().gymId == gymId &&
          staffHasAny4(gymId, 'canManageReminders', 'canViewMembers', 'canManageMembers', 'canViewReports')
        );
        allow create: if isValidId(gymId) && isValidId(settingId) &&
          isValidGymSettings(incoming(), gymId) &&
          incoming().updatedAt == request.time && (
            isSuperAdmin() ||
            (isSignedIn() && isPendingGymOwnerAfter(gymId))
          );
        allow update: if isValidId(gymId) && isValidId(settingId) &&
          isValidGymSettings(incoming(), gymId) &&
          incoming().updatedAt == request.time && (
            ((isSuperAdmin() || (isGymOwner(gymId) && isGymActive(gymId))) &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'gracePeriodDays', 'renewalPolicy', 'reminderDaysBefore', 'sendOnExpiryDay',
                'sendAfterExpiryDays', 'paymentRemindersEnabled', 'upcomingPaymentReminderDays',
                'overduePaymentReminderDays', 'ownerSubReminderDays', 'lastReminderRunDate',
                'emailEnabled', 'emailFromName', 'inAppEnabled', 'whatsappEnabled',
                'whatsappPhoneNumberId', 'whatsappApprovedTemplate', 'currencySymbol', 'updatedAt'
              ])) ||
            (isGymActive(gymId) && staffHasPerm(gymId, 'canManageReminders') &&
              incoming().diff(existing()).affectedKeys().hasOnly([
                'reminderDaysBefore', 'sendOnExpiryDay', 'sendAfterExpiryDays',
                'paymentRemindersEnabled', 'upcomingPaymentReminderDays',
                'overduePaymentReminderDays', 'ownerSubReminderDays', 'lastReminderRunDate',
                'emailEnabled', 'inAppEnabled', 'updatedAt'
              ]))
          );
        allow delete: if false;
      }

      match /staff/{staffId} {
        allow get: if isValidId(gymId) && isValidId(staffId) && (
          isSuperAdmin() || (
            isGymActive(gymId) &&
            (isGymOwner(gymId) || (request.auth.uid == staffId && isGymStaff(gymId)))
          )
        );
        allow list: if isSuperAdmin() || (
          isGymActive(gymId) && existing().gymId == gymId && isGymOwner(gymId)
        );
        allow create: if isValidId(gymId) && isValidId(staffId) &&
          isValidGymStaff(incoming(), gymId) &&
          incoming().id == staffId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time && (
            isSuperAdmin() ||
            (isSignedIn() &&
              staffId == request.auth.uid &&
              incoming().uid == request.auth.uid &&
              emailMatches(incoming().email) &&
              incoming().status == 'ACTIVE' && (
                (incoming().role == 'GYM_OWNER' && isPendingGymOwnerAfter(gymId)) ||
                (incoming().role in ['GYM_MANAGER', 'GYM_RECEPTIONIST', 'GYM_TRAINER'] &&
                  ('invitationId' in incoming()) &&
                  isGymActiveAfter(gymId) &&
                  isAcceptedInviteForUser(incoming().invitationId, gymId, incoming().role) &&
                  incoming().permissions == getAfter(/databases/$(database)/documents/invitations/$(incoming().invitationId)).data.permissions
                )
              )
            )
          );
        allow update: if isValidId(gymId) && isValidId(staffId) &&
          isValidGymStaff(incoming(), gymId) &&
          incoming().id == existing().id &&
          incoming().gymId == existing().gymId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (isSuperAdmin() || (isGymOwner(gymId) && isGymActive(gymId))) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'uid', 'fullName', 'phone', 'role', 'roleTitle', 'status', 'permissions', 'updatedAt'
          ]);
        allow delete: if false;
      }

      match /membership_plans/{planId} {
        allow get: if isValidId(gymId) && isValidId(planId) && (
          isSuperAdmin() || (
            isGymActive(gymId) &&
            staffHasAny3(gymId, 'canManagePlans', 'canViewMembers', 'canManageMembers')
          )
        );
        allow list: if isSuperAdmin() || (
          isGymActive(gymId) &&
          existing().gymId == gymId &&
          staffHasAny3(gymId, 'canManagePlans', 'canViewMembers', 'canManageMembers')
        );
        allow create: if isValidId(gymId) && isValidId(planId) &&
          isValidMembershipPlan(incoming(), gymId) &&
          incoming().id == planId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          (isSuperAdmin() || (isGymActive(gymId) && staffHasPerm(gymId, 'canManagePlans')));
        allow update: if isValidId(gymId) && isValidId(planId) &&
          isValidMembershipPlan(incoming(), gymId) &&
          incoming().id == existing().id &&
          incoming().gymId == existing().gymId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (isSuperAdmin() || (isGymActive(gymId) && staffHasPerm(gymId, 'canManagePlans'))) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'name', 'durationType', 'durationValue', 'price', 'description', 'benefits', 'status', 'updatedAt'
          ]);
        allow delete: if isValidId(gymId) && isValidId(planId) &&
          (isSuperAdmin() || (isGymActive(gymId) && staffHasPerm(gymId, 'canManagePlans')));
      }

      match /members/{memberId} {
        allow get: if isValidId(gymId) && isValidId(memberId) && (
          isSuperAdmin() || (
            isGymActive(gymId) && staffHasAny2(gymId, 'canViewMembers', 'canManageMembers')
          )
        );
        allow list: if isSuperAdmin() || (
          isGymActive(gymId) &&
          existing().gymId == gymId &&
          staffHasAny2(gymId, 'canViewMembers', 'canManageMembers')
        );
        allow create: if isValidId(gymId) && isValidId(memberId) &&
          isValidMember(incoming(), gymId) &&
          incoming().id == memberId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          (isSuperAdmin() || (isGymActive(gymId) && staffHasPerm(gymId, 'canManageMembers')));
        allow update: if isValidId(gymId) && isValidId(memberId) &&
          isValidMember(incoming(), gymId) &&
          incoming().id == existing().id &&
          incoming().gymId == existing().gymId &&
          incoming().memberCode == existing().memberCode &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            isSuperAdmin() || (
              isGymActive(gymId) && (
                (staffHasPerm(gymId, 'canManageMembers') &&
                  incoming().diff(existing()).affectedKeys().hasOnly([
                    'fullName', 'phone', 'email', 'gender', 'dateOfBirth', 'address',
                    'emergencyContact', 'currentPlanId', 'currentPlanName',
                    'membershipStartDate', 'membershipExpiryDate', 'membershipStatus',
                    'outstandingBalance', 'reminderOptOut', 'notes', 'isArchived', 'updatedAt'
                  ])) ||
                (staffHasPerm(gymId, 'canConfirmPayments') &&
                  incoming().diff(existing()).affectedKeys().hasOnly([
                    'outstandingBalance', 'updatedAt'
                  ]))
              )
            )
          );
        allow delete: if isValidId(gymId) && isValidId(memberId) &&
          (isSuperAdmin() || (isGymActive(gymId) && staffHasPerm(gymId, 'canDeleteMembers')));
      }

      match /memberships/{membershipId} {
        allow get: if isValidId(gymId) && isValidId(membershipId) && (
          isSuperAdmin() || (
            isGymActive(gymId) && staffHasAny2(gymId, 'canViewMembers', 'canManageMembers')
          )
        );
        allow list: if isSuperAdmin() || (
          isGymActive(gymId) &&
          existing().gymId == gymId &&
          staffHasAny2(gymId, 'canViewMembers', 'canManageMembers')
        );
        allow create: if isValidId(gymId) && isValidId(membershipId) &&
          isValidMembership(incoming(), gymId) &&
          incoming().id == membershipId &&
          incoming().recordedByUid == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          (isSuperAdmin() || (isGymActive(gymId) && staffHasPerm(gymId, 'canManageMembers')));
        allow update: if isValidId(gymId) && isValidId(membershipId) &&
          isValidMembership(incoming(), gymId) &&
          incoming().id == existing().id &&
          incoming().gymId == existing().gymId &&
          incoming().memberId == existing().memberId &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            isSuperAdmin() || (
              isGymActive(gymId) && (
                (staffHasPerm(gymId, 'canManageMembers') &&
                  incoming().diff(existing()).affectedKeys().hasOnly([
                    'amountPaid', 'balanceDue', 'status', 'expiryDate',
                    'cancelledAt', 'cancellationReason', 'notes', 'updatedAt'
                  ])) ||
                (staffHasPerm(gymId, 'canConfirmPayments') &&
                  incoming().diff(existing()).affectedKeys().hasOnly([
                    'amountPaid', 'balanceDue', 'updatedAt'
                  ]))
              )
            )
          );
        allow delete: if false;
      }

      match /member_payments/{paymentId} {
        allow get: if isValidId(gymId) && isValidId(paymentId) && (
          isSuperAdmin() || (isGymActive(gymId) && staffHasPerm(gymId, 'canViewPayments'))
        );
        allow list: if isSuperAdmin() || (
          isGymActive(gymId) && existing().gymId == gymId && staffHasPerm(gymId, 'canViewPayments')
        );
        allow create: if isValidId(gymId) && isValidId(paymentId) &&
          isValidMemberPayment(incoming(), gymId) &&
          incoming().id == paymentId &&
          incoming().recordedByUid == request.auth.uid &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time && (
            isSuperAdmin() || (
              isGymActive(gymId) &&
              staffHasPerm(gymId, 'canRecordPayments') && (
                incoming().status == 'PENDING' ||
                (incoming().status == 'CONFIRMED' && staffHasPerm(gymId, 'canConfirmPayments'))
              )
            )
          );
        allow update: if isValidId(gymId) && isValidId(paymentId) &&
          isValidMemberPayment(incoming(), gymId) &&
          incoming().id == existing().id &&
          incoming().gymId == existing().gymId &&
          incoming().memberId == existing().memberId &&
          incoming().amount == existing().amount &&
          incoming().paymentMode == existing().paymentMode &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time && (
            isSuperAdmin() || (
              isGymActive(gymId) &&
              staffHasPerm(gymId, 'canConfirmPayments') && (
                (existing().status == 'PENDING' &&
                  incoming().status in ['CONFIRMED', 'REJECTED'] &&
                  incoming().diff(existing()).affectedKeys().hasOnly([
                    'status', 'confirmedByUid', 'receiptNumber', 'notes', 'updatedAt'
                  ])) ||
                (existing().status == 'CONFIRMED' &&
                  incoming().status == 'REFUNDED' &&
                  incoming().diff(existing()).affectedKeys().hasOnly([
                    'status', 'notes', 'updatedAt'
                  ]))
              )
            )
          );
        allow delete: if false;
      }

      match /payment_receipts/{receiptId} {
        allow get: if isValidId(gymId) && isValidId(receiptId) && (
          isSuperAdmin() || (isGymActive(gymId) && staffHasPerm(gymId, 'canViewPayments'))
        );
        allow list: if isSuperAdmin() || (
          isGymActive(gymId) && existing().gymId == gymId && staffHasPerm(gymId, 'canViewPayments')
        );
        allow create: if isValidId(gymId) && isValidId(receiptId) &&
          isValidPaymentReceipt(incoming(), gymId) &&
          incoming().id == receiptId &&
          incoming().issuedByUid == request.auth.uid &&
          incoming().issuedAt == request.time &&
          (isSuperAdmin() || (isGymActive(gymId) && staffHasPerm(gymId, 'canConfirmPayments')));
        allow update, delete: if false;
      }

      match /attendance/{attendanceId} {
        allow get: if isValidId(gymId) && isValidId(attendanceId) && (
          isSuperAdmin() || (isGymActive(gymId) && staffHasPerm(gymId, 'canManageAttendance'))
        );
        allow list: if isSuperAdmin() || (
          isGymActive(gymId) && existing().gymId == gymId && staffHasPerm(gymId, 'canManageAttendance')
        );
        allow create: if isValidId(gymId) && isValidId(attendanceId) &&
          isValidAttendanceRecord(incoming(), gymId) &&
          incoming().id == attendanceId &&
          incoming().recordedByUid == request.auth.uid &&
          incoming().createdAt == request.time &&
          (isSuperAdmin() || (isGymActive(gymId) && staffHasPerm(gymId, 'canManageAttendance')));
        allow update: if isValidId(gymId) && isValidId(attendanceId) &&
          isValidAttendanceRecord(incoming(), gymId) &&
          incoming().id == existing().id &&
          incoming().gymId == existing().gymId &&
          incoming().memberId == existing().memberId &&
          incoming().checkInDate == existing().checkInDate &&
          incoming().checkInTime == existing().checkInTime &&
          incoming().createdAt == existing().createdAt &&
          (isSuperAdmin() || (isGymActive(gymId) && staffHasPerm(gymId, 'canManageAttendance'))) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['checkOutTime', 'notes']);
        allow delete: if false;
      }

      match /notifications/{notificationId} {
        allow get: if isValidId(gymId) && isValidId(notificationId) && (
          isSuperAdmin() || (
            isGymActive(gymId) &&
            staffHasAny3(gymId, 'canManageReminders', 'canViewReports', 'canManageMembers')
          )
        );
        allow list: if isSuperAdmin() || (
          isGymActive(gymId) &&
          existing().gymId == gymId &&
          staffHasAny3(gymId, 'canManageReminders', 'canViewReports', 'canManageMembers')
        );
        allow create: if isValidId(gymId) && isValidId(notificationId) &&
          isValidGymNotification(incoming(), gymId) &&
          incoming().id == notificationId &&
          incoming().createdAt == request.time && (
            isSuperAdmin() || (
              isGymActive(gymId) &&
              staffHasAny4(gymId, 'canManageMembers', 'canRecordPayments', 'canConfirmPayments', 'canManageReminders')
            )
          );
        allow update: if isValidId(gymId) && isValidId(notificationId) &&
          isValidGymNotification(incoming(), gymId) &&
          incoming().id == existing().id &&
          incoming().gymId == existing().gymId &&
          incoming().createdAt == existing().createdAt && (
            isSuperAdmin() || (
              isGymActive(gymId) &&
              staffHasAny3(gymId, 'canManageReminders', 'canViewReports', 'canManageMembers')
            )
          ) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
        allow delete: if false;
      }

      match /notification_logs/{logId} {
        allow get: if isValidId(gymId) && isValidId(logId) && (
          isSuperAdmin() || (isGymActive(gymId) && staffHasPerm(gymId, 'canManageReminders'))
        );
        allow list: if isSuperAdmin() || (
          isGymActive(gymId) && existing().gymId == gymId && staffHasPerm(gymId, 'canManageReminders')
        );
        allow create: if isValidId(gymId) && isValidId(logId) &&
          isValidNotificationLog(incoming(), gymId) &&
          incoming().id == logId &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time &&
          (isSuperAdmin() || (isGymActive(gymId) && staffHasPerm(gymId, 'canManageReminders')));
        allow update: if isValidId(gymId) && isValidId(logId) &&
          isValidNotificationLog(incoming(), gymId) &&
          incoming().id == existing().id &&
          incoming().gymId == existing().gymId &&
          incoming().dedupKey == existing().dedupKey &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (isSuperAdmin() || (isGymActive(gymId) && staffHasPerm(gymId, 'canManageReminders'))) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'deliveryStatus', 'retryCount', 'errorDetails',
            'providerMessageId', 'sentAt', 'lastAttemptAt', 'nextRetryAt', 'updatedAt'
          ]);
        allow delete: if false;
      }
    }

    match /platform_notifications/{notificationId} {
      allow get: if isValidId(notificationId) && isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create: if isValidId(notificationId) && isSignedIn() &&
        isValidPlatformNotification(incoming()) &&
        incoming().id == notificationId &&
        incoming().createdAt == request.time && (
          isSuperAdmin() ||
          (isPublicRegistrationAllowed() &&
            incoming().type == 'NEW_GYM_REGISTERED' &&
            ('gymId' in incoming()) &&
            isValidId(incoming().gymId) &&
            getAfter(/databases/$(database)/documents/gyms/$(incoming().gymId)).data.ownerUid == request.auth.uid
          )
        );
      allow update: if isValidId(notificationId) && isSuperAdmin() &&
        isValidPlatformNotification(incoming()) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().diff(existing()).affectedKeys().hasOnly(['isRead']);
      allow delete: if false;
    }

    match /audit_logs/{logId} {
      allow get: if isValidId(logId) && (
        isSuperAdmin() ||
        (isSignedIn() && existing().actorUid == request.auth.uid) ||
        (isSignedIn() && ('gymId' in existing()) && isGymOwner(existing().gymId))
      );
      allow list: if isSuperAdmin() || (
        isSignedIn() && (
          existing().actorUid == request.auth.uid ||
          (isActiveUser() && userData().role == 'GYM_OWNER' && existing().gymId == userData().gymId)
        )
      );
      allow create: if isValidId(logId) && isSignedIn() &&
        isValidAuditLog(incoming()) &&
        incoming().id == logId &&
        incoming().actorUid == request.auth.uid &&
        emailMatches(incoming().actorEmail) &&
        incoming().createdAt == request.time && (
          !('gymId' in incoming()) ? isSuperAdmin() : (
            isSuperAdmin() ||
            isGymStaff(incoming().gymId) ||
            (existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)) &&
              isUserActiveInGymAfter(incoming().gymId)) ||
            getAfter(/databases/$(database)/documents/gyms/$(incoming().gymId)).data.ownerUid == request.auth.uid
          )
        );
      allow update, delete: if false;
    }
  }
}
