# ---------------------------------------------------------------------------
# Server Runtime
# ---------------------------------------------------------------------------
PORT="3000"
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Controlled Super Admin Bootstrap (Recommended for fresh deployments)
# ---------------------------------------------------------------------------
# One-time secret token required by POST /api/admin/bootstrap or scripts/init-super-admin.mjs.
# Leave blank after initial platform admin setup is complete.
SUPER_ADMIN_BOOTSTRAP_TOKEN=""

# Optional Firebase Admin SDK service account JSON (single-line JSON string).
# Required outside Google Cloud / ADC environments for server-side cron or bootstrap writes.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# ---------------------------------------------------------------------------
# Email Notification Delivery (Free-first SMTP via Nodemailer)
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="GymOS <noreply@example.com>"

# ---------------------------------------------------------------------------
# Optional Official Meta WhatsApp Business Cloud API
# ---------------------------------------------------------------------------
WHATSAPP_CLOUD_ACCESS_TOKEN=""
WHATSAPP_API_VERSION="v20.0"

# ---------------------------------------------------------------------------
# Scheduled Background Reminder Worker / Cron Endpoint
# ---------------------------------------------------------------------------
# Shared secret for POST /api/cron/reminders (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""
# Interval in minutes for in-process retry & reminder sweep (0 disables automatic timer)
REMINDER_WORKER_INTERVAL_MINUTES="30"
