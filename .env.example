# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GEMINI_API_KEY: Platform runtime secret placeholder.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ---------------------------------------------------------------------------
# Portable PostgreSQL / Supabase Configuration (VPS / Self-Hosted Migration)
# ---------------------------------------------------------------------------
POSTGRES_DB="gymos"
POSTGRES_USER="gymos_app"
POSTGRES_PASSWORD="REPLACE_WITH_STRONG_PASSWORD"
DATABASE_URL="postgresql://gymos_app:REPLACE_WITH_STRONG_PASSWORD@localhost:5432/gymos"

# Optional Supabase client configuration (when deploying against Supabase)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------------------
# Optional Official Notifications (Free-first: In-App & Email primary)
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="GymOS <noreply@example.com>"

# Optional Official Meta WhatsApp Business Cloud API (never unofficial bots)
WHATSAPP_CLOUD_ACCESS_TOKEN=""
WHATSAPP_API_VERSION="v20.0"
